{
  "name": "devforge-desktop",
  "version": "0.7.0-beta.1",
  "private": true,
  "description": "DevForge modular IDE for Windows, Linux and macOS",
  "license": "MIT",
  "homepage": "https://github.com/Bony-Lord/devforge",
  "author": "DevForge contributors",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "package": "node package.cjs",
    "installers": "node installers.cjs",
    "test:ui": "node ui-regressions.cjs",
    "prepare:codeoss": "node compat/prepare.cjs",
    "build:all": "node build.cjs --channel=all",
    "build:debug": "node build.cjs --channel=debug",
    "build:release": "node build.cjs --channel=release",
    "installers:debug": "node installers.cjs --channel=debug",
    "installers:release": "node installers.cjs --channel=release"
  },
  "dependencies": {
    "iconv-lite": "0.7.3",
    "json5": "2.2.3",
    "semver": "7.8.5",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.17.0",
    "resedit": "1.7.2"
  }
}
