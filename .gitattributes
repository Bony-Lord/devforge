* text=auto
gradlew text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
app/src/main/assets/ui/vs/** -text -whitespace linguist-vendored
app/src/main/assets/ui/icons/** -text -whitespace linguist-vendored
app/src/main/assets/ui/vendor/** -text -whitespace linguist-vendored
app/src/main/assets/ui/icons.js text eol=lf linguist-generated
icons.lock.json text eol=lf linguist-generated
licenses/** -text -whitespace
gradle/wrapper/** linguist-generated
native-packages.lock.json linguist-generated
verification*.json linguist-generated

# Preserve the upstream printer checksum on Windows checkouts.
app/src/main/assets/debug/libcxx/*.py text eol=lf
